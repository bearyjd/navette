<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Backup stays on, but the pairing store is excluded from it by both rule
        files below. It is EncryptedSharedPreferences: the ciphertext backs up,
        the Android Keystore master key cannot, and a restored file is
        undecryptable forever. Both attributes are required — fullBackupContent
        covers API 23-30 and dataExtractionRules covers 31+, and minSdk 26 with
        targetSdk 36 means devices in the field use each.
    -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Navette"
        android:supportsRtl="true">

        <!--
            configChanges keeps the session screen's landscape lock from
            recreating this Activity. Without it, SessionScreen's
            requestedOrientation = LANDSCAPE (entered from portrait) tears the
            Activity down and rebuilds it, which reopens the media socket on
            every session entry and makes the orientation restore capture an
            already-landscape value, permanently landscape-locking the whole
            app. Handling these configs here means entering and leaving the
            session screen never recreates anything.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="true"
            android:theme="@style/Theme.Navette">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
